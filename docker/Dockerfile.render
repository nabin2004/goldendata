# Render image for the Manim-AOS dataset pipeline.
# Pin MANIM_TAG to a release matching pyproject (manim>=0.19,<0.20), e.g. v0.19.0 (check Docker Hub tags).
ARG MANIM_TAG=stable
FROM manimcommunity/manim:${MANIM_TAG}

# Installing system packages needs root; the base image's default user is not root.
USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends sox libsox-fmt-all \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir "manim-voiceover>=0.3.7" "gTTS>=2.5" pyyaml httpx

# Extra LaTeX packages (the base image ships a minimal TeX Live):
# RUN tlmgr install ctex

WORKDIR /manim
# AOSSpeechService is mounted at runtime from the AOS monorepo (see AOS_REPO / AOS_PYTHONPATH).
